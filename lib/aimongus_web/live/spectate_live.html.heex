<Layouts.game flash={@flash}>
  <% badge = phase_badge(assigns) %>
  <% {banner_title, banner_mod} = meeting_banner(@phase) %>
  <div
    id="sound-root"
    phx-hook="SoundHook"
    class="h-screen w-screen flex flex-col bg-[#04060c] text-slate-100 overflow-hidden"
  >
    <header class="flex items-center gap-4 px-4 py-2 border-b-2 border-[#1c2b33] bg-gradient-to-b from-[#22333d] to-[#17242c]">
      <div class="flex items-baseline gap-2">
        <svg viewBox="0 0 20 23" class="w-4 h-5 self-center -rotate-6" aria-hidden="true">
          <rect
            x="1"
            y="7.5"
            width="5.5"
            height="9.5"
            rx="2.4"
            fill="#8f1d1d"
            stroke="#0d161c"
            stroke-width="1"
          />
          <path
            d="M 6.5 20.5 L 6.5 9 Q 6.5 4 11 4 Q 15.5 4 15.5 9 L 15.5 20.5 L 13.2 20.5 L 13.2 18.8 Q 13.2 17.8 11 17.8 Q 8.8 17.8 8.8 18.8 L 8.8 20.5 Z"
            fill="#c92a2a"
            stroke="#0d161c"
            stroke-width="1.1"
          />
          <rect
            x="10"
            y="6"
            width="6.5"
            height="4.6"
            rx="2.3"
            fill="#bfe8fa"
            stroke="#0d161c"
            stroke-width="1"
          />
        </svg>
        <span class="font-display text-xl text-[#e8f4f4] drop-shadow-[2px_2px_0_rgba(0,0,0,0.55)] -rotate-1 tracking-wide">
          <span class="text-[#ff5c5c]">AI</span>MONGUS
        </span>
        <span class="font-log text-[10px] text-[#7d97a3]">match {@match_id}</span>
      </div>
      <span class={[
        "rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider",
        elem(badge, 1)
      ]}>
        {elem(badge, 0)}
      </span>
      <div :if={@running?} class="flex items-center gap-4 font-log text-[11px] text-slate-400">
        <span>
          <span class="text-emerald-400">{alive_count(@players)}</span> alive
        </span>
        <span :if={tasks_total(@task_pool) > 0}>
          tasks <span class="text-emerald-400">{tasks_done(@task_pool)}</span>/{tasks_total(
            @task_pool
          )}
        </span>
      </div>
      <div class="flex-1"></div>
      <button
        id="sound-toggle"
        phx-click="toggle_sound"
        class={[
          "flex items-center gap-1.5 rounded-lg border-b-4 px-3 py-1 font-label text-[12px] font-bold uppercase tracking-wider transition-all active:translate-y-0.5 active:border-b-2",
          (@muted && "border-[#8a3232] bg-[#b03a3a] text-[#ffe3e3] hover:bg-[#c04343]") ||
            "border-[#1d5f63] bg-[#3fc5cb] text-[#0d2a2d] hover:bg-[#4fd4da]"
        ]}
        aria-label={(@muted && "Enable sound") || "Mute sound"}
      >
        <.icon
          name={(@muted && "hero-speaker-x-mark") || "hero-speaker-wave"}
          class="size-3.5"
        />
        {(@muted && "Enable sound") || "Mute sound"}
      </button>
      <button
        id="admin-toggle"
        phx-click="toggle_admin"
        class={[
          "flex items-center gap-1.5 rounded-lg border-b-4 px-3 py-1 font-label text-[12px] font-bold uppercase tracking-wider transition-all active:translate-y-0.5 active:border-b-2",
          (@admin_open? && "border-[#1d5f63] bg-[#3fc5cb] text-[#0d2a2d]") ||
            "border-[#33505c] bg-[#233740] text-[#9fc3cc] hover:bg-[#2a434d] hover:text-[#cfe8ec]"
        ]}
        aria-label="Match admin"
      >
        <.icon name="hero-adjustments-horizontal" class="size-3.5" /> Admin
      </button>
      <span class="hidden sm:inline font-label text-[11px] font-semibold uppercase tracking-wider text-[#5f7d89]">
        god view — spectators see all roles
      </span>
    </header>

    <div
      :if={@admin_open?}
      id="admin-panel"
      class="fixed right-4 top-14 z-40 w-80 rounded-xl border border-slate-700/80 bg-[#0b1120]/95 p-4 shadow-2xl backdrop-blur-md space-y-3"
    >
      <div class="flex items-center justify-between border-b border-slate-800 pb-2">
        <div class="flex items-center gap-2">
          <.icon name="hero-shield-check" class="size-4 text-sky-400" />
          <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-slate-200">
            Match Config
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button
            :if={@admin_unlocked?}
            id="admin-lock"
            type="button"
            phx-click="lock_admin"
            class="font-log text-[10px] uppercase tracking-wider text-slate-400 hover:text-rose-300"
          >
            Lock
          </button>
          <button
            id="admin-close"
            type="button"
            phx-click="close_admin"
            class="text-slate-500 hover:text-slate-200 text-lg leading-none px-1"
            aria-label="Close admin panel"
          >
            ×
          </button>
        </div>
      </div>

      <%= cond do %>
        <% not admin_enabled?() -> %>
          <p class="font-log text-xs text-slate-400 leading-relaxed">
            Admin controls disabled — set <code class="text-sky-300">AIMONGUS_ADMIN_TOKEN</code>
            to enable match configuration.
          </p>
        <% not @admin_unlocked? -> %>
          <.form
            for={@admin_auth_form}
            id="admin-unlock-form"
            phx-submit="unlock_admin"
            class="space-y-2.5"
          >
            <p class="font-log text-[11px] text-slate-400">
              Enter operator token to configure and restart matches.
            </p>
            <.input
              field={@admin_auth_form[:token]}
              type="password"
              placeholder="AIMONGUS_ADMIN_TOKEN"
              autocomplete="off"
              class="w-full rounded-lg border border-slate-700 bg-slate-950/90 px-3 py-1.5 font-log text-xs text-slate-100 placeholder:text-slate-600 focus:border-sky-500 focus:outline-none"
            />
            <div
              :if={@admin_auth_error}
              id="admin-auth-error"
              class="font-log text-[11px] text-rose-400"
            >
              {@admin_auth_error}
            </div>
            <button
              id="admin-unlock-submit"
              type="submit"
              class="w-full rounded-lg bg-sky-600 hover:bg-sky-500 px-3 py-1.5 font-display text-[11px] font-bold uppercase tracking-widest text-white transition-colors"
            >
              Unlock
            </button>
          </.form>
        <% true -> %>
          <.form
            for={@admin_config_form}
            id="admin-config-form"
            phx-change="validate_admin_config"
            phx-submit="start_admin_match"
            class="space-y-3"
          >
            <div class="grid grid-cols-2 gap-2.5">
              <div>
                <label class="block font-log text-[10px] uppercase tracking-wider text-slate-400 mb-1">
                  Agents (3–9)
                </label>
                <.input
                  field={@admin_config_form[:agent_count]}
                  type="number"
                  min="3"
                  max="9"
                  class="w-full rounded-lg border border-slate-700 bg-slate-950/90 px-2.5 py-1.5 font-log text-xs text-slate-100 focus:border-sky-500 focus:outline-none"
                />
              </div>
              <div>
                <label class="block font-log text-[10px] uppercase tracking-wider text-slate-400 mb-1">
                  Impostors (1–3)
                </label>
                <.input
                  field={@admin_config_form[:impostors]}
                  type="number"
                  min="1"
                  max="3"
                  class="w-full rounded-lg border border-slate-700 bg-slate-950/90 px-2.5 py-1.5 font-log text-xs text-slate-100 focus:border-sky-500 focus:outline-none"
                />
              </div>
            </div>

            <div>
              <div class="font-log text-[10px] uppercase tracking-wider text-slate-400 mb-1.5">
                Special roles
              </div>
              <div class="grid grid-cols-2 gap-1.5 font-log text-xs text-slate-300">
                <.input
                  field={@admin_config_form[:sheriff]}
                  type="checkbox"
                  label="Sheriff"
                  class="rounded border-slate-600 bg-slate-900 text-sky-500"
                />
                <.input
                  field={@admin_config_form[:medic]}
                  type="checkbox"
                  label="Medic"
                  class="rounded border-slate-600 bg-slate-900 text-sky-500"
                />
                <.input
                  field={@admin_config_form[:vigilante]}
                  type="checkbox"
                  label="Vigilante"
                  class="rounded border-slate-600 bg-slate-900 text-sky-500"
                />
                <.input
                  field={@admin_config_form[:jester]}
                  type="checkbox"
                  label="Jester"
                  class="rounded border-slate-600 bg-slate-900 text-sky-500"
                />
                <.input
                  field={@admin_config_form[:serial_killer]}
                  type="checkbox"
                  label="Serial Killer"
                  class="rounded border-slate-600 bg-slate-900 text-sky-500"
                />
              </div>
            </div>

            <div>
              <label class="block font-log text-[10px] uppercase tracking-wider text-slate-400 mb-1">
                Game speed
              </label>
              <.input
                field={@admin_config_form[:speed]}
                type="select"
                options={[
                  {"0.5x (Slow)", "0.5"},
                  {"1x (Normal)", "1.0"},
                  {"2x (Fast)", "2.0"},
                  {"4x (Turbo)", "4.0"}
                ]}
                class="w-full rounded-lg border border-slate-700 bg-slate-950/90 px-2.5 py-1.5 font-log text-xs text-slate-100 focus:border-sky-500 focus:outline-none"
              />
            </div>

            <div class="rounded-lg border border-slate-800 bg-slate-950/60 px-2.5 py-1.5 font-log text-[10px] text-slate-400">
              {admin_role_summary(@admin_config_params)}
            </div>

            <div
              :if={@admin_config_error}
              id="admin-config-error"
              class="font-log text-[11px] text-rose-400"
            >
              {@admin_config_error}
            </div>

            <button
              id="admin-start-match"
              type="submit"
              class="w-full rounded-lg bg-rose-600 hover:bg-rose-500 px-3 py-2 font-display text-[11px] font-bold uppercase tracking-widest text-white transition-colors"
            >
              Start New Match
            </button>
          </.form>
      <% end %>
    </div>

    <div class="flex flex-1 min-h-0">
      <main class="relative flex-1 flex items-center justify-center min-w-0 min-h-0 p-4 overflow-hidden space-bg">
        <div
          class="map-stage relative rounded-2xl p-2 flex items-center justify-center max-w-full max-h-full"
          style={"aspect-ratio: #{@map.width} / #{@map.height}; width: min(100%, calc((100vh - 5.5rem) * #{@map.width} / #{@map.height}));"}
        >
          <svg
            id="ship-map"
            width={@map.width * @cell}
            height={@map.height * @cell}
            viewBox={"0 0 #{@map.width * @cell} #{@map.height * @cell}"}
            preserveAspectRatio="xMidYMid meet"
            class="block w-full h-full"
            role="img"
            aria-label="ship map"
          >
            <defs>
              <linearGradient id="sh-n" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#000" stop-opacity="0.55" />
                <stop offset="1" stop-color="#000" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="sh-s" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#000" stop-opacity="0" />
                <stop offset="1" stop-color="#000" stop-opacity="0.55" />
              </linearGradient>
              <linearGradient id="sh-w" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#000" stop-opacity="0.55" />
                <stop offset="1" stop-color="#000" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="sh-e" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#000" stop-opacity="0" />
                <stop offset="1" stop-color="#000" stop-opacity="0.55" />
              </linearGradient>
            </defs>

            <%!-- floor + walls (checkered tint per room) --%>
            <rect
              :for={{x, y} <- Map.keys(@map.tiles)}
              x={x * @cell}
              y={y * @cell}
              width={@cell}
              height={@cell}
              class="tile"
              fill={tile_fill(@map, @room_hues, @decor.doors, {x, y})}
              stroke="#0b1020"
              stroke-width="0.5"
            />

            <%!-- wall inner shadows --%>
            <rect
              :for={sh <- @decor.shadows}
              x={sh.x}
              y={sh.y}
              width={sh.w}
              height={sh.h}
              fill={"url(#sh-#{sh.side})"}
            />

            <%!-- neon room edges: a wide soft halo + a crisp line --%>
            <path
              :for={edge <- @decor.edges}
              d={edge.d}
              fill="none"
              stroke={room_edge_color(@room_hues, edge.name)}
              stroke-width="4"
              stroke-opacity="0.12"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
            <path
              :for={edge <- @decor.edges}
              d={edge.d}
              fill="none"
              stroke={room_edge_color(@room_hues, edge.name)}
              stroke-width="1.7"
              stroke-opacity="0.9"
              stroke-linejoin="round"
            />

            <%!-- hull rim: a crisp metallic edge framing the ship silhouette --%>
            <rect
              x="1.25"
              y="1.25"
              width={@map.width * @cell - 2.5}
              height={@map.height * @cell - 2.5}
              fill="none"
              stroke="#263549"
              stroke-width="2.5"
            />
            <rect
              x="4"
              y="4"
              width={@map.width * @cell - 8}
              height={@map.height * @cell - 8}
              fill="none"
              stroke="#0f172a"
              stroke-width="1"
              opacity="0.8"
            />

            <%!-- door sills --%>
            <rect
              :for={sill <- @decor.sills}
              x={sill.x}
              y={sill.y}
              width={sill.w}
              height={sill.h}
              rx="1"
              fill="#fbbf24"
              opacity="0.8"
            />

            <%!-- room labels --%>
            <text
              :for={label <- @room_labels}
              x={label.x}
              y={label.y}
              text-anchor="middle"
              dominant-baseline="middle"
              class="room-label uppercase"
              style="font-size: 8.5px; letter-spacing: 0.18em; fill: rgba(226,232,240,0.55);"
            >
              {label.name}
            </text>

            <%!-- room furniture (decorative) --%>
            <g
              :for={prop <- @decor.props}
              id={"prop-#{prop.kind}-#{prop.x}-#{prop.y}"}
              transform={"translate(#{prop.x * @cell} #{prop.y * @cell})"}
            >
              <.prop_art kind={prop.kind} cell={@cell} />
            </g>

            <%!-- task spots --%>
            <g
              :for={{task_id, pos} <- Enum.sort(@map.tasks)}
              id={"task-#{task_id}"}
              class={["task-spot", @task_pool[task_id] && "done"]}
            >
              <% {cx, cy} = pawn_center(pos) %>
              <% done? = !!@task_pool[task_id] %>
              <path
                class="task-glow"
                d={"M #{cx} #{cy - 9} L #{cx + 9} #{cy} L #{cx} #{cy + 9} L #{cx - 9} #{cy} Z"}
                fill={if done?, do: "#22c55e", else: "#fbbf24"}
                opacity="0.25"
              />
              <path
                d={"M #{cx} #{cy - 5.5} L #{cx + 5.5} #{cy} L #{cx} #{cy + 5.5} L #{cx - 5.5} #{cy} Z"}
                fill={if done?, do: "#22c55e", else: "#fbbf24"}
                fill-opacity={if done?, do: "0.95", else: "0.75"}
                stroke={if done?, do: "#86efac", else: "#fde68a"}
                stroke-width="0.9"
              />
            </g>

            <%!-- emergency button --%>
            <g :if={@map.button} id="emergency-button" class="task-spot">
              <% {bx, by} = pawn_center(@map.button) %>
              <circle cx={bx} cy={by} r="8" fill="#450a0a" stroke="#ef4444" stroke-width="1.6">
                <animate
                  attributeName="stroke-opacity"
                  values="1;0.35;1"
                  dur="2s"
                  repeatCount="indefinite"
                />
              </circle>
              <circle cx={bx} cy={by} r="3.4" fill="#fca5a5" />
            </g>

            <%!-- dead bodies: a toppled half-bean plus the classic bone --%>
            <g
              :for={body <- @bodies}
              class="body"
              style={"transform: translate(#{elem(body.pos, 0) * @cell}px, #{elem(body.pos, 1) * @cell}px)"}
            >
              <% body_color = player_color(@players, body.player_id) %>
              <ellipse
                cx={@cell / 2}
                cy={@cell * 0.8}
                rx={@cell * 0.4}
                ry={@cell * 0.16}
                fill="#000"
                opacity="0.4"
              />
              <g transform={"rotate(-16 #{@cell / 2} #{@cell * 0.6})"}>
                <path
                  d={"M #{@cell * 0.22} #{@cell * 0.78} L #{@cell * 0.22} #{@cell * 0.56} Q #{@cell * 0.22} #{@cell * 0.4} #{@cell * 0.4} #{@cell * 0.4} L #{@cell * 0.62} #{@cell * 0.4} Q #{@cell * 0.8} #{@cell * 0.4} #{@cell * 0.8} #{@cell * 0.56} L #{@cell * 0.8} #{@cell * 0.78} Z"}
                  fill={body_color}
                  fill-opacity="0.9"
                  stroke={shade(body_color, 0.45)}
                  stroke-width="0.8"
                />
                <rect
                  x={@cell * 0.55}
                  y={@cell * 0.44}
                  width={@cell * 0.24}
                  height={@cell * 0.14}
                  rx={@cell * 0.07}
                  fill="#9fd9f4"
                  stroke="#3f86ad"
                  stroke-width="0.6"
                />
              </g>
              <rect
                x={@cell * 0.78}
                y={@cell * 0.6}
                width={@cell * 0.14}
                height={@cell * 0.09}
                rx={@cell * 0.045}
                fill="#e2e8f0"
              />
              <circle cx={@cell * 0.8} cy={@cell * 0.58} r={@cell * 0.05} fill="#e2e8f0" />
              <circle cx={@cell * 0.8} cy={@cell * 0.71} r={@cell * 0.05} fill="#e2e8f0" />
            </g>

            <%!-- pawns: original bean-with-backpack crewmates --%>
            <g
              :for={{id, player} <- sorted_players(@players)}
              id={"pawn-#{id}"}
              class={[
                "pawn cursor-pointer",
                (player.alive? && "alive") || "ghost",
                MapSet.member?(@ejected_ids, id) && "ejected",
                MapSet.member?(@moving, id) && "moving",
                @speaking == id && "speaking",
                @selected_agent == id && "selected"
              ]}
              phx-click="select_agent"
              phx-value-id={id}
              style={"transform: #{pawn_translate(@players, id, @cell)}; transition: transform 100ms linear;"}
              opacity={(player.alive? && "1") || "0.35"}
            >
              <circle
                :if={@selected_agent == id}
                cx={@cell / 2}
                cy={@cell * 0.6}
                r={@cell * 0.56}
                fill="none"
                stroke="#e2e8f0"
                stroke-width="1.5"
                class="selected-ring"
              />
              <text
                x={@cell / 2}
                y="-4"
                text-anchor="middle"
                class="fill-slate-100"
                style="font-size: 8px; font-weight: 700; paint-order: stroke; stroke: #04060c; stroke-width: 2.5px;"
              >
                {player_name(@players, id)}
              </text>
              <circle
                :if={@speaking == id}
                cx={@cell / 2}
                cy={@cell * 0.6}
                r={@cell * 0.5}
                fill="none"
                stroke="#facc15"
                stroke-width="1.5"
                class="speaking-ring"
              >
                <animate attributeName="r" values="11;19" dur="1.2s" repeatCount="indefinite" />
                <animate
                  attributeName="stroke-opacity"
                  values="0.9;0"
                  dur="1.2s"
                  repeatCount="indefinite"
                />
              </circle>
              <circle
                :if={murder_role?(player.role)}
                cx={@cell / 2}
                cy={@cell * 0.6}
                r={@cell * 0.5}
                fill="none"
                stroke="#b91c1c"
                stroke-width="1"
                stroke-dasharray="3 2"
              />
              <% color = pawn_color(player) %>
              <g class="pawn-bob" style={"animation-delay: #{bob_delay(id)}ms"}>
                <g transform={"translate(#{@cell / 2} #{@cell * 0.55}) scale(1.3) translate(#{-@cell / 2} #{-@cell * 0.55})"}>
                  <ellipse
                    cx={@cell / 2}
                    cy={@cell * 0.9}
                    rx={@cell * 0.3}
                    ry={@cell * 0.075}
                    fill="#000"
                    opacity="0.35"
                  />
                  <rect
                    x={@cell * 0.11}
                    y={@cell * 0.4}
                    width={@cell * 0.18}
                    height={@cell * 0.34}
                    rx={@cell * 0.075}
                    fill={shade(color, 0.6)}
                    stroke="#101823"
                    stroke-width="0.9"
                  />
                  <path
                    d={"M #{@cell * 0.26} #{@cell * 0.86} L #{@cell * 0.26} #{@cell * 0.48} Q #{@cell * 0.26} #{@cell * 0.22} #{@cell * 0.51} #{@cell * 0.22} Q #{@cell * 0.76} #{@cell * 0.22} #{@cell * 0.76} #{@cell * 0.48} L #{@cell * 0.76} #{@cell * 0.86} L #{@cell * 0.63} #{@cell * 0.86} L #{@cell * 0.63} #{@cell * 0.8} Q #{@cell * 0.63} #{@cell * 0.74} #{@cell * 0.51} #{@cell * 0.74} Q #{@cell * 0.39} #{@cell * 0.74} #{@cell * 0.39} #{@cell * 0.8} L #{@cell * 0.39} #{@cell * 0.86} Z"}
                    fill={color}
                    stroke="#101823"
                    stroke-width="1.1"
                  />
                  <rect
                    x={@cell * 0.45}
                    y={@cell * 0.31}
                    width={@cell * 0.29}
                    height={@cell * 0.19}
                    rx={@cell * 0.095}
                    fill="#bfe8fa"
                    stroke="#182530"
                    stroke-width="1"
                  />
                  <circle
                    cx={@cell * 0.57}
                    cy={@cell * 0.375}
                    r={@cell * 0.04}
                    fill="#fff"
                    opacity="0.85"
                  />
                </g>
              </g>
              <g :if={@working[id]}>
                <% {_task_id, pct} = @working[id] %>
                <rect
                  x="3"
                  y={@cell - 4}
                  width={@cell - 6}
                  height="3"
                  rx="1.5"
                  fill="#04060c"
                  opacity="0.85"
                />
                <rect
                  x="3"
                  y={@cell - 4}
                  width={(@cell - 6) * pct / 100}
                  height="3"
                  rx="1.5"
                  fill="#22c55e"
                />
              </g>
            </g>

            <%!-- one-shot event fx: expanding rings (kill = red, report = yellow) --%>
            <g :for={f <- @fx} id={"fx-#{f.seq}"}>
              <% {fx_cx, fx_cy} = pawn_center(f.pos) %>
              <circle
                cx={fx_cx}
                cy={fx_cy}
                r="6"
                fill="none"
                stroke={if f.kind == :kill, do: "#ef4444", else: "#facc15"}
                stroke-width="2.5"
                opacity="0"
              >
                <animate attributeName="r" from="6" to="54" dur="1.1s" fill="freeze" />
                <animate
                  attributeName="opacity"
                  values="0.9;0.9;0"
                  keyTimes="0;0.3;1"
                  dur="1.1s"
                  fill="freeze"
                />
              </circle>
            </g>
            <rect
              :for={f <- Enum.filter(@fx, &(&1.kind == :kill))}
              id={"fx-svg-flash-#{f.seq}"}
              width={@map.width * @cell}
              height={@map.height * @cell}
              fill="#ef4444"
              fill-opacity="0"
            >
              <animate
                attributeName="fill-opacity"
                values="0;0.32;0"
                keyTimes="0;0.2;1"
                dur="0.8s"
                fill="freeze"
              />
            </rect>
          </svg>
          <div :if={lights_out?(@sabotage)} class="lights-out absolute inset-0 rounded-2xl"></div>
          <div class="vignette absolute inset-0 rounded-2xl"></div>
        </div>

        <div
          :if={@sabotage}
          id="sabotage-alert"
          class="sabotage-alert absolute inset-x-0 top-0 z-10 flex items-center justify-center gap-3 px-4 py-1.5"
        >
          <.icon name="hero-exclamation-triangle-solid" class="size-4 text-red-300" />
          <span class="font-display text-[11px] font-extrabold uppercase tracking-[0.3em] text-red-200">
            {(@sabotage.kind == :reactor && "Reactor meltdown — fix at Reactor") ||
              "Lights out — fix at Electrical"}
          </span>
          <span
            :if={@sabotage[:ends_in_seconds]}
            class="relative w-28 h-1.5 rounded-full bg-red-950/80 overflow-hidden"
          >
            <span
              class="meltdown-bar absolute inset-y-0 left-0 bg-red-400"
              style={"animation-duration: #{@sabotage.ends_in_seconds}s"}
            ></span>
          </span>
          <.icon name="hero-exclamation-triangle-solid" class="size-4 text-red-300" />
        </div>

        <div
          :for={f <- Enum.filter(@fx, &(&1.kind == :kill))}
          id={"kill-flash-#{f.seq}"}
          class="kill-flash absolute inset-0 z-10 pointer-events-none"
        >
        </div>

        <div
          :if={not @running?}
          class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-7 bg-[#04060c]/80"
        >
          <div class="radar">
            <span></span>
            <span></span>
            <span></span>
            <span class="radar-dot"></span>
          </div>
          <div class="flex flex-col items-center gap-1.5">
            <span class="font-display text-xl font-bold uppercase tracking-[0.35em] text-slate-200">
              Waiting for match
            </span>
            <span class="font-log text-xs text-slate-500">
              the page goes live as soon as the game starts
            </span>
          </div>
        </div>

        <div
          :if={meeting?(@phase)}
          id="meeting-overlay"
          class="meeting-overlay absolute inset-0 z-20 flex flex-col items-center justify-center gap-6 bg-[#04060c]/70 backdrop-blur-[1.5px]"
        >
          <div class={["meeting-banner w-80 rounded-md py-2 text-center", banner_mod]}>
            <span class="font-display text-sm font-extrabold uppercase tracking-[0.35em] text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]">
              {banner_title}
            </span>
          </div>
          <div
            id="vote-tablet"
            class="vote-tablet w-[27rem] max-w-[94%] rounded-2xl border-[5px] border-[#17242e] bg-[#c3cfd9] shadow-[0_18px_55px_rgba(0,0,0,0.7)] overflow-hidden"
          >
            <div class="flex items-center justify-between bg-[#a9bcc9] border-b-2 border-[#8fa5b5] px-4 py-2">
              <span class="font-display text-[13px] font-extrabold uppercase tracking-[0.16em] text-[#1f2e3a]">
                Who is the impostor?
              </span>
              <.icon name="hero-megaphone-solid" class="size-5 text-[#c2410c]" />
            </div>
            <div class="grid grid-cols-3 gap-1.5 p-2.5">
              <div
                :for={{id, player} <- sorted_players(@players)}
                id={"vote-row-#{id}"}
                class={[
                  "vote-row flex items-center gap-1.5 rounded-md px-1.5 py-1 min-w-0",
                  (player.alive? && "bg-white/55") || "bg-white/25 opacity-60",
                  @speaking == id && "vote-row-speaking"
                ]}
              >
                <svg viewBox="0 0 20 23" class="w-4 h-5 shrink-0" aria-hidden="true">
                  <rect
                    x="1"
                    y="7.5"
                    width="5.5"
                    height="9.5"
                    rx="2.4"
                    fill={shade(pawn_color(player), 0.62)}
                    stroke="#182530"
                    stroke-width="1"
                  />
                  <path
                    d="M 6.5 20.5 L 6.5 9 Q 6.5 4 11 4 Q 15.5 4 15.5 9 L 15.5 20.5 L 13.2 20.5 L 13.2 18.8 Q 13.2 17.8 11 17.8 Q 8.8 17.8 8.8 18.8 L 8.8 20.5 Z"
                    fill={pawn_color(player)}
                    stroke="#182530"
                    stroke-width="1.1"
                  />
                  <rect
                    x="10"
                    y="6"
                    width="6.5"
                    height="4.6"
                    rx="2.3"
                    fill="#bfe8fa"
                    stroke="#182530"
                    stroke-width="1"
                  />
                </svg>
                <div class="min-w-0 flex-1">
                  <div class={[
                    "font-display text-[10px] font-bold uppercase tracking-wide truncate",
                    (player.alive? && "text-[#1f2e3a]") || "text-[#5c6b76] line-through"
                  ]}>
                    {player_name(@players, id)}
                  </div>
                  <div
                    :if={@phase == :voting && Map.has_key?(@votes, id)}
                    class="flex items-center gap-1 text-[9px] font-bold uppercase text-[#b3392e] truncate"
                  >
                    <.icon name="hero-megaphone-solid" class="size-3 shrink-0" />
                    {vote_label(@votes[id], @players)}
                  </div>
                </div>
                <span
                  :if={@phase == :voting && Map.has_key?(@votes, id)}
                  class="text-emerald-600 text-xs font-black leading-none"
                >
                  ✓
                </span>
                <span
                  :if={not player.alive?}
                  class="text-[#8c9aa5] text-xs font-black leading-none"
                >
                  ✗
                </span>
              </div>
            </div>
            <div class="flex items-center justify-between px-3.5 py-2 border-t-2 border-[#8fa5b5] bg-[#aebfd0]">
              <span class="rounded-md bg-[#1f2e3a] px-3 py-1 font-display text-[9px] font-bold uppercase tracking-[0.2em] text-slate-200">
                Skip vote
              </span>
              <span class="font-log text-[10px] font-bold uppercase tracking-wider text-[#3a4b58]">
                {(@phase == :voting && "#{map_size(@votes)}/#{alive_count(@players)} voted") ||
                  "discuss — then vote"}
              </span>
            </div>
          </div>
          <div class="font-log text-[10px] uppercase tracking-[0.3em] text-slate-500">
            {(@phase == :meeting && "discussion — keep your alibi straight") || "cast your votes"}
          </div>
        </div>

        <div
          :if={@winner}
          id="gameover-banner"
          class="gameover-banner absolute inset-x-0 top-8 z-30 mx-auto w-fit px-10 py-5 rounded-2xl border text-center backdrop-blur-md"
          style={"border-color: #{winner_accent(@winner)}66; background: rgba(5,9,18,0.88); box-shadow: 0 0 70px #{winner_accent(@winner)}33"}
        >
          <div
            class="font-display text-[11px] font-semibold uppercase tracking-[0.45em]"
            style={"color: #{winner_accent(@winner)}"}
          >
            Game over
          </div>
          <div
            class="font-display text-3xl font-extrabold uppercase tracking-wider mt-1"
            style={"color: #{winner_accent(@winner)}; text-shadow: 0 0 26px #{winner_accent(@winner)}66"}
          >
            {winner_text(@players, @winner)}
          </div>
        </div>
      </main>

      <aside class="w-80 lg:w-96 flex flex-col border-l-2 border-[#1c2b33] bg-gradient-to-b from-[#141f26]/95 to-[#0d151b]/95 min-h-0">
        <% player = @players[@selected_agent] %>
        <div
          :if={player}
          id="mind-panel"
          class="border-b border-slate-700 bg-slate-900/80 px-4 py-3 space-y-2.5 shrink-0"
          style={"box-shadow: inset 3px 0 0 #{pawn_color(player)}"}
        >
          <% color = pawn_color(player) %>
          <div class="flex items-center gap-2">
            <span
              class="inline-block w-3 h-3 rounded-full shrink-0"
              style={"background: #{color}"}
            ></span>
            <span class="text-sm font-bold" style={"color: #{color}"}>
              {player_name(@players, @selected_agent)}
            </span>
            <span class={[
              "rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider",
              (player.alive? && "bg-emerald-500/20 text-emerald-300") ||
                "bg-rose-500/20 text-rose-300"
            ]}>
              {(player.alive? && "Alive") || "Dead"}
            </span>
            <span class="text-[10px] uppercase tracking-wider text-slate-500">
              {role_label(player.role)}
            </span>
            <div class="flex-1"></div>
            <button
              id="mind-panel-close"
              phx-click="deselect_agent"
              class="text-slate-500 hover:text-slate-200 text-lg leading-none px-1"
              aria-label="close mind panel"
            >
              ×
            </button>
          </div>
          <div class="font-log text-[11px] text-slate-400">
            in {agent_room(@map, player)}
          </div>
          <div id="mind-card" class="space-y-1">
            <div class="text-[10px] uppercase tracking-widest text-slate-500">Personality</div>
            <div :if={trait_rows(player) == []} class="text-[11px] text-slate-500">
              no card on file
            </div>
            <div :for={row <- trait_rows(player)} class="flex items-center gap-2 text-[11px]">
              <span class="w-20 shrink-0 text-slate-400">{row.label}</span>
              <div class="flex-1 h-1.5 rounded-full bg-slate-800 overflow-hidden">
                <div
                  class="h-full rounded-full"
                  style={"width: #{row.value * 10}%; background: #{color}"}
                >
                </div>
              </div>
              <span class="w-4 shrink-0 text-right text-slate-500">{row.value}</span>
              <span
                class="w-28 shrink-0 truncate text-right italic text-slate-300"
                title={row.phrase}
              >
                {row.phrase}
              </span>
            </div>
          </div>
          <div id="mind-reasoning">
            <div class="text-[10px] uppercase tracking-widest text-slate-500">Latest thought</div>
            <div :if={@minds[@selected_agent]} class="text-xs italic text-slate-300">
              “{@minds[@selected_agent]}”
            </div>
            <div :if={is_nil(@minds[@selected_agent])} class="text-xs italic text-slate-500">
              thinking…
            </div>
          </div>
        </div>
        <div class="px-4 py-2 border-b border-slate-800/80 flex items-center gap-2">
          <span
            :if={@running?}
            class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.9)] animate-pulse"
          ></span>
          <span class="font-display text-[10px] font-semibold uppercase tracking-[0.3em] text-slate-400">
            Live feed
          </span>
        </div>
        <div
          id="event-feed"
          class="flex-1 flex flex-col-reverse overflow-y-auto px-3 py-2 gap-1.5 min-h-0 font-log"
        >
          <div :for={entry <- @feed} id={"feed-#{entry.seq}"} class={feed_class(entry)}>
            <%= case entry.kind do %>
              <% :speech -> %>
                <div
                  class="rounded-lg px-3 py-2 border border-slate-700/60 border-l-[3px]"
                  style={"border-left-color: #{player_color(@players, entry.player)}; background: color-mix(in srgb, #{player_color(@players, entry.player)} 10%, rgba(15,23,42,0.75))"}
                >
                  <div
                    class="text-[10px] font-bold uppercase tracking-wider"
                    style={"color: #{player_color(@players, entry.player)}"}
                  >
                    {player_name(@players, entry.player)}
                  </div>
                  <div class="text-[13px] text-slate-100 leading-snug">{entry.text}</div>
                </div>
              <% :whisper -> %>
                <div class="ml-5 rounded-lg px-3 py-1.5 bg-slate-800/20 border border-dashed border-slate-700/80 italic opacity-90">
                  <div class="text-[10px] uppercase tracking-wider text-slate-500">
                    <span
                      class="font-semibold"
                      style={"color: #{player_color(@players, entry.player)}"}
                    >
                      {player_name(@players, entry.player)}
                    </span>
                    whispered<%= if entry.target do %>
                      to
                      <span
                        class="font-semibold"
                        style={"color: #{player_color(@players, entry.target)}"}
                      >
                        {player_name(@players, entry.target)}
                      </span>
                    <% end %>
                  </div>
                  <div class="text-[13px] text-slate-500">{entry.text}</div>
                </div>
              <% :event -> %>
                <div class="flex items-baseline gap-2 px-2 py-1 text-[13px] text-slate-300">
                  <span
                    class="inline-block w-2 h-2 rounded-full shrink-0 self-center"
                    style={"background: #{player_color(@players, entry.player)}"}
                  ></span>
                  <span>
                    <b style={"color: #{player_color(@players, entry.player)}"}>
                      {player_name(@players, entry.player)}
                    </b>
                    {entry.text}
                  </span>
                </div>
              <% :system -> %>
                <div class="text-center text-[11px] text-slate-500 py-1 tracking-wide">
                  {entry.text}
                </div>
            <% end %>
          </div>
          <div :if={@feed == []} class="text-center text-xs text-slate-600 py-6">
            match events will appear here
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layouts.game>
